<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tc_msgs</name>
  <version>0.0.1</version>
  <!-- Trimmed subset ported for amr_motion_control_2wd / amr_safety_core.
       Only the motor-independent SafetyStatus message is kept.
       Motor-specific messages (WheelMotor, WheelMotorState, MotorDriver,
       MotorStatus, Odometry, Io, AmrAlarm) and services/actions from the
       original T-AMR tc_msgs are intentionally omitted — they vary per motor
       and must be re-defined for the target drivetrain. -->
  <description>tc_msgs (trimmed): motor-independent messages required by the AMR motion control port</description>
  <maintainer email="amap@t-robotics.com">amap</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

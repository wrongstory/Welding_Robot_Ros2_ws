            <property name="readOnly"><bool>true</bool></property>
            <property name="maximumBlockCount"><number>200</number></property>
            <property name="styleSheet"><string notr="true">QPlainTextEdit { font-family:monospace; font-size:9pt; }</string></property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="log_btns">
            <item>
             <spacer name="log_spacer">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
             </spacer>
            </item>
            <item>
             <widget class="QPushButton" name="btn_clear_log">
              <property name="text"><string>Clear Log</string></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>

      </layout>
     </widget>
     <!-- ================ END TAB 2 ================ -->

     <!-- ================ TAB 3: Settings ================ -->
     <widget class="QWidget" name="tab_settings">
      <attribute name="title"><string>Settings</string></attribute>
      <layout class="QVBoxLayout" name="settings_layout">
       <property name="spacing"><number>12</number></property>

       <item>
        <widget class="QGroupBox" name="grp_speed_limits">
         <property name="title"><string>Stage 1 — Teleop Velocity Limits  (cmd_vel cap on active teleop node)</string></property>
         <property name="styleSheet">
          <string notr="true">QGroupBox { color:#bbb; border:1px solid #444; border-radius:4px; margin-top:8px; padding-top:14px; } QGroupBox::title { subcontrol-origin: margin; left:10px; padding:0 4px; }</string>
         </property>
         <layout class="QGridLayout" name="speed_grid">
          <property name="horizontalSpacing"><number>14</number></property>
          <property name="verticalSpacing"><number>10</number></property>

          <!-- Row 0: Linear -->
          <item row="0" column="0">
           <widget class="QLabel" name="lbl_cap_linear">
            <property name="text"><string>Max linear (m/s)</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="spin_max_linear">
            <property name="minimumSize"><size><width>120</width><height>30</height></size></property>
            <property name="decimals"><number>2</number></property>
            <property name="minimum"><double>0.05</double></property>
            <property name="maximum"><double>2.00</double></property>
            <property name="singleStep"><double>0.05</double></property>
            <property name="value"><double>2.00</double></property>
            <property name="suffix"><string> m/s</string></property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QLabel" name="lbl_linear_current">
            <property name="text"><string>(current: --)</string></property>
            <property name="styleSheet"><string notr="true">QLabel { color:#888; font-family:monospace; }</string></property>
           </widget>
          </item>

          <!-- Row 1: Angular (deg/s on the UI, converted to rad/s when published) -->
          <item row="1" column="0">
           <widget class="QLabel" name="lbl_cap_angular">
            <property name="text"><string>Max angular (deg/s)</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="spin_max_angular_deg">
            <property name="minimumSize"><size><width>120</width><height>30</height></size></property>
            <property name="decimals"><number>1</number></property>
            <property name="minimum"><double>1.0</double></property>
            <property name="maximum"><double>120.0</double></property>
            <property name="singleStep"><double>1.0</double></property>
            <property name="value"><double>30.0</double></property>
            <property name="suffix"><string> deg/s</string></property>
           </widget>
          </item>
          <item row="1" column="2">
           <widget class="QLabel" name="lbl_angular_current">
            <property name="text"><string>(current: --)</string></property>
            <property name="styleSheet"><string notr="true">QLabel { color:#888; font-family:monospace; }</string></property>
           </widget>
          </item>

          <!-- Row 2: target node + buttons -->
          <item row="2" column="0">
           <widget class="QLabel" name="lbl_cap_target">
            <property name="text"><string>Target teleop node</string></property>
           </widget>
          </item>
          <item row="2" column="1" colspan="2">
           <widget class="QComboBox" name="cmb_target_node">
            <property name="minimumSize"><size><width>200</width><height>30</height></size></property>
            <item><property name="text"><string>/microntek_teleop</string></property></item>
            <item><property name="text"><string>/pro_controller_teleop</string></property></item>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

       <item>
        <layout class="QHBoxLayout" name="settings_btn_row">
         <property name="spacing"><number>10</number></property>
         <item>
          <widget class="QPushButton" name="btn_settings_apply">
           <property name="minimumSize"><size><width>140</width><height>40</height></size></property>
           <property name="text"><string>APPLY</string></property>
           <property name="styleSheet">
            <string notr="true">QPushButton { background:#206020; color:white; border:2px solid #40c040; border-radius:6px; font-weight:bold; } QPushButton:hover { background:#208020; }</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_settings_refresh">
           <property name="minimumSize"><size><width>140</width><height>40</height></size></property>
           <property name="text"><string>REFRESH</string></property>
           <property name="styleSheet">
            <string notr="true">QPushButton { background:#204060; color:white; border:2px solid #4080c0; border-radius:6px; font-weight:bold; } QPushButton:hover { background:#205080; }</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_settings_defaults">
           <property name="minimumSize"><size><width>180</width><height>40</height></size></property>
           <property name="text"><string>RESET TO 2.0 / 30°</string></property>
           <property name="styleSheet">
            <string notr="true">QPushButton { background:#3a3a3a; color:#ddd; border:1px solid #777; border-radius:6px; font-weight:bold; } QPushButton:hover { background:#4a4a4a; }</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="settings_btn_spacer">
           <property name="orientation"><enum>Qt::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
          </spacer>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QLabel" name="lbl_settings_hint">
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>NOTE: Stage 1 caps cmd_vel at the teleop node — joystick → /cmd_vel limit. APPLY calls /set_parameters (live, no restart). For permanence, edit microntek_teleop.yaml + rebuild. Operational defaults (2026-05-07): 2.0 m/s, 0.5236 rad/s = 30°/s — rpm_limit_2026-05-06.md.</string></property>
         <property name="styleSheet"><string notr="true">QLabel { color:#888; font-size:9pt; padding:6px; }</string></property>
        </widget>
       </item>

       <item>
        <widget class="QGroupBox" name="grp_fw_rpm_limits">
         <property name="title"><string>Stage 2 — Firmware Motor Limits  (ESP32 NVS, kinematics-converted to motor RPM)</string></property>
         <property name="styleSheet">
          <string notr="true">QGroupBox { color:#bbb; border:1px solid #444; border-radius:4px; margin-top:8px; padding-top:14px; } QGroupBox::title { subcontrol-origin: margin; left:10px; padding:0 4px; }</string>
         </property>
         <layout class="QGridLayout" name="fw_rpm_grid">
          <property name="horizontalSpacing"><number>14</number></property>
          <property name="verticalSpacing"><number>10</number></property>

          <item row="0" column="0">
           <widget class="QLabel" name="lbl_cap_fw_lin"><property name="text"><string>Max linear (m/s)</string></property></widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="spin_fw_max_lin">
            <property name="minimumSize"><size><width>120</width><height>30</height></size></property>
            <property name="decimals"><number>2</number></property>
            <property name="minimum"><double>0.01</double></property>
            <property name="maximum"><double>3.00</double></property>
            <property name="singleStep"><double>0.05</double></property>
            <property name="value"><double>2.00</double></property>
            <property name="suffix"><string> m/s</string></property>
           </widget>
          </item>
          <item row="0" column="2">
           <widget class="QLabel" name="lbl_fw_lin_status">
            <property name="text"><string>RAM: --   NVS: --</string></property>
            <property name="styleSheet"><string notr="true">QLabel { color:#888; font-family:monospace; }</string></property>
           </widget>
          </item>

          <item row="1" column="0">
           <widget class="QLabel" name="lbl_cap_fw_rot"><property name="text"><string>Max angular (deg/s)</string></property></widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="spin_fw_max_rot">
            <property name="minimumSize"><size><width>120</width><height>30</height></size></property>
            <property name="decimals"><number>1</number></property>
            <property name="minimum"><double>1.0</double></property>
            <property name="maximum"><double>360.0</double></property>
            <property name="singleStep"><double>1.0</double></property>
            <property name="value"><double>30.0</double></property>
            <property name="suffix"><string> deg/s</string></property>
           </widget>
          </item>
          <item row="1" column="2">
           <widget class="QLabel" name="lbl_fw_rot_status">
            <property name="text"><string>RAM: --   NVS: --</string></property>
            <property name="styleSheet"><string notr="true">QLabel { color:#888; font-family:monospace; }</string></property>
           </widget>
          </item>

          <item row="2" column="0">
           <widget class="QLabel" name="lbl_cap_fw_kine"><property name="text"><string>Kinematics</string></property></widget>
          </item>
          <item row="2" column="1" colspan="2">
           <widget class="QLabel" name="lbl_fw_kine">
            <property name="text"><string>(querying /diff_drive_controller ...)</string></property>
            <property name="styleSheet"><string notr="true">QLabel { color:#888; font-family:monospace; font-size:9pt; }</string></property>
           </widget>
          </item>

          <item row="3" column="0">
           <widget class="QLabel" name="lbl_cap_fw_source"><property name="text"><string>Source</string></property></widget>
          </item>
          <item row="3" column="1" colspan="2">
           <widget class="QLabel" name="lbl_fw_source">
            <property name="text"><string>--</string></property>
            <property name="styleSheet"><string notr="true">QLabel { color:#888; font-family:monospace; }</string></property>
           </widget>
          </item>

         </layout>
        </widget>
       </item>

       <item>
        <layout class="QHBoxLayout" name="fw_btn_row">
         <property name="spacing"><number>10</number></property>
         <item>
          <widget class="QPushButton" name="btn_fw_apply_ram">
           <property name="minimumSize"><size><width>160</width><height>40</height></size></property>
           <property name="text"><string>APPLY (RAM only)</string></property>
           <property name="toolTip"><string>Send #L with persist=0 — values active until next reboot, NVS untouched</string></property>
           <property name="styleSheet">
            <string notr="true">QPushButton { background:#604020; color:white; border:2px solid #c0a040; border-radius:6px; font-weight:bold; } QPushButton:hover { background:#806030; }</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_fw_apply_nvs">
           <property name="minimumSize"><size><width>180</width><height>40</height></size></property>
           <property name="text"><string>APPLY &amp;&amp; SAVE (NVS)</string></property>
           <property name="toolTip"><string>Send #L with persist=1 — values active AND saved to ESP32 NVS, survive reboot</string></property>
           <property name="styleSheet">
            <string notr="true">QPushButton { background:#206020; color:white; border:2px solid #40c040; border-radius:6px; font-weight:bold; } QPushButton:hover { background:#208020; }</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_fw_load_nvs">
           <property name="minimumSize"><size><width>160</width><height>40</height></size></property>
           <property name="text"><string>LOAD FROM NVS</string></property>
           <property name="toolTip"><string>Read EEPROM-saved values from ESP32 NVS and populate spinboxes (so user can edit and APPLY). Sends #G; on #I echo, fills spinboxes with nvs_lin/nvs_rot fields (survives reboot).</string></property>
           <property name="styleSheet">
            <string notr="true">QPushButton { background:#206060; color:white; border:2px solid #40a0a0; border-radius:6px; font-weight:bold; } QPushButton:hover { background:#208080; }</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_fw_refresh">
           <property name="minimumSize"><size><width>140</width><height>40</height></size></property>
           <property name="text"><string>REFRESH</string></property>
           <property name="toolTip"><string>Monitor: send #G, display RAM/NVS values in labels (does NOT touch spinboxes — use LOAD FROM NVS for that).</string></property>
           <property name="styleSheet">
            <string notr="true">QPushButton { background:#204060; color:white; border:2px solid #4080c0; border-radius:6px; font-weight:bold; } QPushButton:hover { background:#205080; }</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="fw_btn_spacer">
           <property name="orientation"><enum>Qt::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
          </spacer>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QLabel" name="lbl_fw_hint">
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>NOTE: Stage 2 clamps motor RPM in firmware (SSOT). Speed limits are converted via wheel kinematics before #L. WRITE: APPLY (RAM)=transient, APPLY &amp;&amp; SAVE=NVS persistent. READ: REFRESH=monitor labels, LOAD FROM NVS=fill spinbox with EEPROM-saved values (then edit + APPLY). Operational defaults (2026-05-07): 2.0 m/s · 30°/s — rpm_limit_2026-05-06.md.</string></property>
         <property name="styleSheet"><string notr="true">QLabel { color:#888; font-size:9pt; padding:6px; }</string></property>
        </widget>
       </item>

       <item>
        <widget class="QPlainTextEdit" name="txt_settings_log">
         <property name="readOnly"><bool>true</bool></property>
         <property name="maximumBlockCount"><number>100</number></property>
         <property name="minimumSize"><size><width>0</width><height>120</height></size></property>
         <property name="styleSheet"><string notr="true">QPlainTextEdit { font-family:monospace; font-size:9pt; }</string></property>
        </widget>
       </item>

       <item>
        <spacer name="settings_v_spacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
        </spacer>
       </item>

      </layout>
     </widget>
     <!-- ================ END TAB 3 ================ -->

     <!-- ================ TAB 4: Pipeline Health ================ -->
     <widget class="QWidget" name="tab_health">
      <attribute name="title"><string>Pipeline Health</string></attribute>
      <layout class="QVBoxLayout" name="health_layout">
       <property name="spacing"><number>8</number></property>

       <item>
        <widget class="QLabel" name="lbl_health_summary">
         <property name="text"><string>(querying chain ...)</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="minimumSize"><size><width>0</width><height>50</height></size></property>
         <property name="styleSheet"><string notr="true">QLabel { background:#2a2a2a; color:#ddd; border:1px solid #555; border-radius:6px; padding:8px; font-size:13pt; font-weight:bold; }</string></property>
        </widget>
       </item>

       <item>
        <widget class="QTableWidget" name="tbl_health">
         <property name="alternatingRowColors"><bool>true</bool></property>
         <property name="selectionMode"><enum>QAbstractItemView::NoSelection</enum></property>
         <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
         <property name="showGrid"><bool>false</bool></property>
         <property name="verticalScrollBarPolicy"><enum>Qt::ScrollBarAsNeeded</enum></property>
         <property name="styleSheet"><string notr="true">QTableWidget { background:#1e1e1e; alternate-background-color:#252525; color:#ddd; gridline-color:#444; font-family:monospace; } QTableWidget::item { padding:4px; } QHeaderView::section { background:#2a2a2a; color:#aaa; padding:4px; border:1px solid #444; font-weight:bold; }</string></property>
         <attribute name="horizontalHeaderStretchLastSection"><bool>true</bool></attribute>
        </widget>
       </item>

       <item>
        <widget class="QLabel" name="lbl_health_hint">
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>NOTE: 10 link chain from joystick → motors. Status dot: green=active(&lt;1s), yellow=stale(1-5s), red=down(&gt;5s or no publishers), gray=idle. Hz column = recent rate. Each link's failure-mode catalog is in docs/sw-architecture/pipeline_chain_failure_modes_2026-05-08.md.</string></property>
         <property name="styleSheet"><string notr="true">QLabel { color:#888; font-size:9pt; padding:6px; }</string></property>
        </widget>
       </item>

      </layout>
     </widget>
     <!-- ================ END TAB 4 ================ -->

    </widget>
   </item>

  </layout>
 </widget>

          <widget class="QPushButton" name="btn_motor_enable">
           <property name="minimumSize"><size><width>180</width><height>0</height></size></property>
           <property name="checkable"><bool>true</bool></property>
           <property name="text"><string>MOTORS DISABLED</string></property>
           <property name="styleSheet">
            <string notr="true">QPushButton { background:#3a1e1e; color:#ff7f7f; padding:8px; border:1px solid #c04040; border-radius:4px; font-weight:bold; } QPushButton:checked { background:#1e3a1e; color:#7fff7f; border:1px solid #3fa83f; }</string>
           </property>
          </widget>
         </item>
         <!-- FREEWHEEL: motor OFF + brake RELEASED. Required for hand rotation. -->
         <item>
          <widget class="QPushButton" name="btn_freewheel">
           <property name="minimumSize"><size><width>140</width><height>0</height></size></property>
           <property name="text"><string>FREEWHEEL</string></property>
           <property name="toolTip"><string>Send /freewheel (Empty) → bridge sends #F → firmware: motor OFF + brake released. For manual rotation (kinematic calibration, hand-pushing). Motor will not respond to RPM commands until MOTORS ENABLED clicked again.</string></property>
           <property name="styleSheet">
            <string notr="true">QPushButton { background:#206060; color:white; padding:8px; border:1px solid #40a0a0; border-radius:4px; font-weight:bold; } QPushButton:hover { background:#208080; }</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>


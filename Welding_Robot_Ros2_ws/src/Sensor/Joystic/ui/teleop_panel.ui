         </property>
        </widget>
       </item>

       <!-- Status row -->
       <item>
        <layout class="QHBoxLayout" name="status_row">
         <property name="spacing"><number>16</number></property>
         <item>
          <widget class="QLabel" name="lbl_deadman">

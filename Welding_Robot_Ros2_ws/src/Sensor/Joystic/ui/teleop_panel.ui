           </property>
          </widget>
         </item>
         <!-- ESP32 bridge connection badge (driven by /joint_states freshness) -->
         <item>
          <widget class="QLabel" name="lbl_bridge_status">
           <property name="minimumSize"><size><width>200</width><height>0</height></size></property>

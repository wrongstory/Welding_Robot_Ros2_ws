<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TeleopPanel</class>
 <widget class="QMainWindow" name="TeleopPanel">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1180</width>
    <height>820</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>FITO AMR — Joystick Teleop Configurator (Designer B)</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="rootLayout">
    <!-- ============================================================
         TOP BAR — controller selector, connection, hz, e-stop, dead-man
         ============================================================ -->
    <item>
     <widget class="QFrame" name="topBar">
      <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
      <property name="frameShadow"><enum>QFrame::Raised</enum></property>
      <layout class="QHBoxLayout" name="topBarLayout">
       <item>
        <widget class="QLabel" name="lblControllerCaption">
         <property name="text"><string>Controller:</string></property>
        </widget>
       </item>
       <item>
        <widget class="QComboBox" name="cmbController">
         <property name="minimumSize"><size><width>260</width><height>0</height></size></property>
         <item><property name="text"><string>Nintendo Switch Pro Controller (Bluetooth)</string></property></item>
         <item><property name="text"><string>Microntek USB Joystick (PSX clone, wired)</string></property></item>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblDevicePath">
         <property name="text"><string>/dev/input/joystick_pro</string></property>
         <property name="styleSheet"><string>color:#888; font-style:italic;</string></property>
        </widget>
       </item>
       <item>
        <spacer name="topSpacer1">
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
        </spacer>
       </item>
       <item>
        <widget class="QLabel" name="lblConnDot">
         <property name="text"><string>●</string></property>
         <property name="styleSheet"><string>color:#cc0000; font-size:18pt;</string></property>
         <property name="toolTip"><string>Joystick connection indicator</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblConnText">
         <property name="text"><string>Disconnected</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblHzCaption">
         <property name="text"><string>/joy:</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblHz">
         <property name="text"><string>0.0 Hz</string></property>
         <property name="minimumSize"><size><width>80</width><height>0</height></size></property>
         <property name="styleSheet"><string>font-family:monospace; font-weight:bold;</string></property>
        </widget>
       </item>
       <item>
        <spacer name="topSpacer2">
         <property name="orientation"><enum>Qt::Horizontal</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
        </spacer>
       </item>
       <item>
        <widget class="QLabel" name="lblDeadmanLed">
         <property name="text"><string>DEAD-MAN</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="minimumSize"><size><width>110</width><height>30</height></size></property>
         <property name="styleSheet"><string>background:#333; color:#888; border:1px solid #222; border-radius:4px; font-weight:bold;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblEstopLed">
         <property name="text"><string>E-STOP LATCHED</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="minimumSize"><size><width>150</width><height>30</height></size></property>
         <property name="styleSheet"><string>background:#330000; color:#770000; border:1px solid #220000; border-radius:4px; font-weight:bold;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnSoftEstop">
         <property name="text"><string>SOFT E-STOP</string></property>
         <property name="minimumSize"><size><width>140</width><height>40</height></size></property>
         <property name="styleSheet"><string>background:#cc0000; color:white; font-weight:bold; border-radius:4px;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnClearEstop">
         <property name="text"><string>Clear E-Stop</string></property>
         <property name="minimumSize"><size><width>110</width><height>40</height></size></property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>

    <!-- ============================================================
         MAIN TABS — Drive / Mapping / Diagnostics / Config
         ============================================================ -->
    <item>
     <widget class="QTabWidget" name="tabsMain">
      <property name="currentIndex"><number>0</number></property>

      <!-- ============================================================
           TAB 1: DRIVE — live joystick state + cmd_vel readout

           <item row="3" column="2" colspan="2"><widget class="QLabel" name="lblButtonsHint"><property name="text"><string>(boxes light up green when pressed; gray = released; red = mapped to E-Stop)</string></property><property name="styleSheet"><string>color:#777; font-size:9pt; font-style:italic;</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
          </layout>
         </widget>
        </item>

        <!-- MIDDLE: axes + sticks -->
        <item>
         <widget class="QGroupBox" name="grpAxes">
          <property name="title"><string>Axes (live)</string></property>
          <layout class="QGridLayout" name="grpAxesLayout">
           <item row="0" column="0"><widget class="QLabel" name="lblAx0Cap"><property name="text"><string>Axis 0 — LStick X</string></property></widget></item>
           <item row="0" column="1"><widget class="QProgressBar" name="barAx0"><property name="minimum"><number>-100</number></property><property name="maximum"><number>100</number></property><property name="value"><number>0</number></property><property name="format"><string>%v%</string></property></widget></item>
           <item row="0" column="2"><widget class="QLabel" name="lblAx0Val"><property name="text"><string>+0.000</string></property><property name="minimumSize"><size><width>70</width><height>0</height></size></property><property name="styleSheet"><string>font-family:monospace;</string></property></widget></item>

           <item row="1" column="0"><widget class="QLabel" name="lblAx1Cap"><property name="text"><string>Axis 1 — LStick Y  ⟵ LINEAR</string></property><property name="styleSheet"><string>color:#3aa3ff; font-weight:bold;</string></property></widget></item>
           <item row="1" column="1"><widget class="QProgressBar" name="barAx1"><property name="minimum"><number>-100</number></property><property name="maximum"><number>100</number></property><property name="value"><number>0</number></property><property name="format"><string>%v%</string></property></widget></item>
           <item row="1" column="2"><widget class="QLabel" name="lblAx1Val"><property name="text"><string>+0.000</string></property><property name="styleSheet"><string>font-family:monospace; color:#3aa3ff; font-weight:bold;</string></property></widget></item>

           <item row="2" column="0"><widget class="QLabel" name="lblAx2Cap"><property name="text"><string>Axis 2 — RStick X  ⟵ ANGULAR</string></property><property name="styleSheet"><string>color:#ffae3a; font-weight:bold;</string></property></widget></item>
           <item row="2" column="1"><widget class="QProgressBar" name="barAx2"><property name="minimum"><number>-100</number></property><property name="maximum"><number>100</number></property><property name="value"><number>0</number></property><property name="format"><string>%v%</string></property></widget></item>
           <item row="2" column="2"><widget class="QLabel" name="lblAx2Val"><property name="text"><string>+0.000</string></property><property name="styleSheet"><string>font-family:monospace; color:#ffae3a; font-weight:bold;</string></property></widget></item>

           <item row="3" column="0"><widget class="QLabel" name="lblAx3Cap"><property name="text"><string>Axis 3 — RStick Y</string></property></widget></item>
           <item row="3" column="1"><widget class="QProgressBar" name="barAx3"><property name="minimum"><number>-100</number></property><property name="maximum"><number>100</number></property><property name="value"><number>0</number></property><property name="format"><string>%v%</string></property></widget></item>
           <item row="3" column="2"><widget class="QLabel" name="lblAx3Val"><property name="text"><string>+0.000</string></property><property name="styleSheet"><string>font-family:monospace;</string></property></widget></item>

           <item row="4" column="0"><widget class="QLabel" name="lblAx4Cap"><property name="text"><string>Axis 4 — D-Pad X</string></property></widget></item>
           <item row="4" column="1"><widget class="QProgressBar" name="barAx4"><property name="minimum"><number>-100</number></property><property name="maximum"><number>100</number></property><property name="value"><number>0</number></property><property name="format"><string>%v%</string></property></widget></item>
           <item row="4" column="2"><widget class="QLabel" name="lblAx4Val"><property name="text"><string>+0.000</string></property><property name="styleSheet"><string>font-family:monospace;</string></property></widget></item>

           <item row="5" column="0"><widget class="QLabel" name="lblAx5Cap"><property name="text"><string>Axis 5 — D-Pad Y</string></property></widget></item>
           <item row="5" column="1"><widget class="QProgressBar" name="barAx5"><property name="minimum"><number>-100</number></property><property name="maximum"><number>100</number></property><property name="value"><number>0</number></property><property name="format"><string>%v%</string></property></widget></item>
           <item row="5" column="2"><widget class="QLabel" name="lblAx5Val"><property name="text"><string>+0.000</string></property><property name="styleSheet"><string>font-family:monospace;</string></property></widget></item>

           <item row="6" column="0" colspan="3">
            <widget class="Line" name="line_axes_sep"><property name="orientation"><enum>Qt::Horizontal</enum></property></widget>

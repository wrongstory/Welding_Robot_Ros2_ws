 <class>TeleopPanel</class>
 <widget class="QWidget" name="TeleopPanel">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1280</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>FITO AMR — Joystick Teleop</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#TeleopPanel { background-color: #1e1e1e; color: #f0f0f0; }
QGroupBox { color: #f0f0f0; border: 1px solid #444; border-radius: 4px; margin-top: 10px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
QLabel { color: #f0f0f0; }
QPushButton { background-color: #2d2d2d; color: #f0f0f0; border: 1px solid #555; padding: 6px; border-radius: 3px; }
QPushButton:hover { background-color: #3a3a3a; }
QPushButton:pressed { background-color: #444; }
QComboBox { background-color: #2d2d2d; color: #f0f0f0; border: 1px solid #555; padding: 4px; }
QProgressBar { border: 1px solid #555; border-radius: 3px; text-align: center; background-color: #111; color: #f0f0f0; }
QProgressBar::chunk { background-color: #2e8b57; }
QTabWidget::pane { border: 1px solid #444; border-radius: 4px; background-color: #1a1a1a; }
QTabBar::tab { background: #2a2a2a; color: #cccccc; padding: 8px 18px; border: 1px solid #444; border-bottom: none; border-top-left-radius: 4px; border-top-right-radius: 4px; }
QTabBar::tab:selected { background: #1a1a1a; color: #ffffff; font-weight: bold; }
QTabBar::tab:hover { background: #3a3a3a; }
QTableWidget { background-color: #141414; alternate-background-color: #1c1c1c; gridline-color: #333; color: #e6e6e6; }
QHeaderView::section { background-color: #2a2a2a; color: #f0f0f0; border: 1px solid #444; padding: 4px; }
QListWidget { background-color: #141414; color: #e6e6e6; border: 1px solid #444; }
QPlainTextEdit { background-color: #101010; color: #dddddd; border: 1px solid #444; }
QSpinBox, QDoubleSpinBox { background-color: #2d2d2d; color: #f0f0f0; border: 1px solid #555; padding: 2px 4px; }
QCheckBox { color: #f0f0f0; }
QLCDNumber { background-color: #050505; color: #00ff80; border: 1px solid #333; }</string>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="spacing"><number>6</number></property>
   <property name="leftMargin"><number>8</number></property>
   <property name="topMargin"><number>8</number></property>
   <property name="rightMargin"><number>8</number></property>
   <property name="bottomMargin"><number>8</number></property>


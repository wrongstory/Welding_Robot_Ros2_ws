         <string notr="true">QLabel#lbl_estop_banner { background-color: #1f4f1f; color: #d8ffd8; font-size: 36pt; font-weight: 900; border: 3px solid #3acb3a; border-radius: 6px; letter-spacing: 4px; }</string>
        </property>
        <property name="toolTip"><string>Safety state. READY = green, LATCHED = solid red with white text.</string></property>
       </widget>
      </item>

      <!-- DEAD-MAN LAMP -->

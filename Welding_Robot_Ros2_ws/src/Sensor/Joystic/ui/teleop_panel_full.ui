     <!-- ========================================================
          TAB 3: DIAGNOSTICS — stream stats, vel buffer, event log
          ======================================================== -->
     <widget class="QWidget" name="tab_diagnostics">
      <attribute name="title"><string>Diagnostics</string></attribute>
      <layout class="QGridLayout" name="layout_tab_diagnostics">
       <property name="leftMargin"><number>8</number></property>
       <property name="topMargin"><number>10</number></property>
       <property name="rightMargin"><number>8</number></property>
       <property name="bottomMargin"><number>8</number></property>
       <property name="horizontalSpacing"><number>10</number></property>
       <property name="verticalSpacing"><number>10</number></property>

       <!-- STREAM STATS -->
       <item row="0" column="0">
        <widget class="QGroupBox" name="grp_stream_stats">
         <property name="title"><string>Stream stats</string></property>
         <layout class="QFormLayout" name="layout_stream_stats">
          <property name="leftMargin"><number>10</number></property>
          <property name="topMargin"><number>22</number></property>
          <property name="rightMargin"><number>10</number></property>
          <property name="bottomMargin"><number>10</number></property>
          <item row="0" column="0"><widget class="QLabel" name="lbl_stat_joy_hz_cap"><property name="text"><string>/joy publish rate (1s avg)</string></property></widget></item>
          <item row="0" column="1"><widget class="QLabel" name="lbl_stat_joy_hz"><property name="text"><string>0.00 Hz</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lbl_stat_cmdvel_hz_cap"><property name="text"><string>/cmd_vel publish rate (1s avg)</string></property></widget></item>
          <item row="1" column="1"><widget class="QLabel" name="lbl_stat_cmdvel_hz"><property name="text"><string>0.00 Hz</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lbl_stat_msg_age_cap"><property name="text"><string>last msg age</string></property></widget></item>
          <item row="2" column="1"><widget class="QLabel" name="lbl_stat_msg_age"><property name="text"><string>— ms</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="lbl_stat_timeout_cap"><property name="text"><string>joy timeout count</string></property></widget></item>
          <item row="3" column="1"><widget class="QLabel" name="lbl_stat_timeout"><property name="text"><string>0</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="4" column="0"><widget class="QLabel" name="lbl_stat_msg_total_cap"><property name="text"><string>messages total</string></property></widget></item>
          <item row="4" column="1"><widget class="QLabel" name="lbl_stat_msg_total"><property name="text"><string>0</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="5" column="0"><widget class="QLabel" name="lbl_stat_last_err_cap"><property name="text"><string>last error</string></property></widget></item>
          <item row="5" column="1"><widget class="QLabel" name="lbl_stat_last_err"><property name="text"><string>(none)</string></property><property name="styleSheet"><string notr="true">color:#cc6666; font-family:monospace;</string></property></widget></item>
         </layout>
        </widget>
       </item>

       <!-- VELOCITY ROLLING BUFFER -->
       <item row="0" column="1">
        <widget class="QGroupBox" name="grp_vel_history">
         <property name="title"><string>Velocity history (rolling buffer)</string></property>
         <layout class="QVBoxLayout" name="layout_vel_history">
          <property name="leftMargin"><number>10</number></property>
          <property name="topMargin"><number>22</number></property>
          <property name="rightMargin"><number>10</number></property>
          <property name="bottomMargin"><number>10</number></property>
          <item>
           <widget class="QPlainTextEdit" name="txt_vel_history">
            <property name="readOnly"><bool>true</bool></property>
            <property name="styleSheet"><string notr="true">font-family:monospace; font-size:9pt; background:#101010; color:#ddd;</string></property>
            <property name="placeholderText"><string>t=…   v=+0.000 m/s   w=+0.000 rad/s   est=0  dm=0</string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <!-- EVENT LOG -->
       <item row="1" column="0" colspan="2">
        <widget class="QGroupBox" name="grp_event_log">
         <property name="title"><string>Event log</string></property>
         <layout class="QVBoxLayout" name="layout_event_log">
          <property name="leftMargin"><number>10</number></property>
          <property name="topMargin"><number>22</number></property>
          <property name="rightMargin"><number>10</number></property>
          <property name="bottomMargin"><number>10</number></property>
          <item>
           <widget class="QPlainTextEdit" name="txt_event_log">
            <property name="readOnly"><bool>true</bool></property>
            <property name="styleSheet"><string notr="true">font-family:monospace; font-size:9pt; background:#0a0a0a; color:#cfcfcf;</string></property>
            <property name="placeholderText"><string>[hh:mm:ss] connect / disconnect / e-stop latched / e-stop cleared / dead-man on/off / mapping reload</string></property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="layout_event_log_btns">
            <item><widget class="QPushButton" name="btn_clear_log"><property name="text"><string>Clear</string></property></widget></item>
            <item><widget class="QPushButton" name="btn_export_log"><property name="text"><string>Export…</string></property></widget></item>
            <item>
             <spacer name="spacer_log_mid">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
             </spacer>
            </item>
            <item><widget class="QCheckBox" name="chk_autoscroll"><property name="text"><string>Auto-scroll</string></property><property name="checked"><bool>true</bool></property></widget></item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ========================================================
          TAB 4: DEVICES — scan + select joystick (USB / BT)
          ======================================================== -->
     <widget class="QWidget" name="tab_devices">
      <attribute name="title"><string>Devices</string></attribute>
      <layout class="QGridLayout" name="layout_tab_devices">
       <property name="leftMargin"><number>8</number></property>
       <property name="topMargin"><number>10</number></property>
       <property name="rightMargin"><number>8</number></property>
       <property name="bottomMargin"><number>8</number></property>
       <property name="horizontalSpacing"><number>10</number></property>
       <property name="verticalSpacing"><number>10</number></property>

       <!-- DEVICE LIST -->
       <item row="0" column="0">
        <widget class="QGroupBox" name="grp_devices_list">
         <property name="title"><string>Connected joysticks</string></property>
         <property name="minimumSize"><size><width>440</width><height>320</height></size></property>
         <layout class="QVBoxLayout" name="layout_devices_list">
          <property name="leftMargin"><number>10</number></property>
          <property name="topMargin"><number>22</number></property>
          <property name="rightMargin"><number>10</number></property>
          <property name="bottomMargin"><number>10</number></property>
          <item>
           <layout class="QHBoxLayout" name="layout_scan_row">
            <item>
             <widget class="QPushButton" name="btn_scan_devices">
              <property name="text"><string>Scan</string></property>
              <property name="minimumSize"><size><width>110</width><height>32</height></size></property>
              <property name="styleSheet"><string notr="true">QPushButton { font-weight: bold; }</string></property>
              <property name="toolTip"><string>Scan /dev/input/js* and bluetoothctl for connected gamepads.</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lbl_scan_hint">
              <property name="text"><string>Click Scan to populate the list.</string></property>
              <property name="styleSheet"><string notr="true">color: #888; font-style: italic;</string></property>
             </widget>
            </item>
            <item>
             <spacer name="spacer_scan_row">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
             </spacer>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QListWidget" name="lst_devices">
            <property name="alternatingRowColors"><bool>true</bool></property>
            <property name="toolTip"><string>Format: [USB] /dev/input/jsX — Microntek USB Joystick   |   [BT] /dev/input/jsY — Pro Controller</string></property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="layout_apply_row">
            <item>
             <widget class="QPushButton" name="btn_apply_device">
              <property name="text"><string>Apply Selection</string></property>
              <property name="minimumSize"><size><width>140</width><height>32</height></size></property>
              <property name="styleSheet"><string notr="true">QPushButton { background-color: #2e5f3e; color: #d8ffd8; border: 1px solid #3acb3a; font-weight: bold; }
QPushButton:hover { background-color: #357046; }</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lbl_apply_hint">
              <property name="text"><string>Stores chosen device path; relaunch the teleop node externally to take effect.</string></property>
              <property name="wordWrap"><bool>true</bool></property>
              <property name="styleSheet"><string notr="true">color: #aaaa66; font-style: italic;</string></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>

       <!-- DEVICE DETAIL -->
       <item row="0" column="1">
        <widget class="QGroupBox" name="grp_device_detail">
         <property name="title"><string>Selected device detail</string></property>
         <property name="minimumSize"><size><width>440</width><height>320</height></size></property>
         <layout class="QFormLayout" name="layout_device_detail">
          <property name="leftMargin"><number>10</number></property>
          <property name="topMargin"><number>22</number></property>
          <property name="rightMargin"><number>10</number></property>
          <property name="bottomMargin"><number>10</number></property>
          <item row="0" column="0"><widget class="QLabel" name="lbl_dev_name_cap"><property name="text"><string>Name</string></property><property name="styleSheet"><string notr="true">color:#aaa;</string></property></widget></item>
          <item row="0" column="1"><widget class="QLabel" name="lbl_dev_name"><property name="text"><string>—</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lbl_dev_path_cap"><property name="text"><string>Path</string></property><property name="styleSheet"><string notr="true">color:#aaa;</string></property></widget></item>
          <item row="1" column="1"><widget class="QLabel" name="lbl_dev_path"><property name="text"><string>—</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lbl_dev_vidpid_cap"><property name="text"><string>Vendor:Product</string></property><property name="styleSheet"><string notr="true">color:#aaa;</string></property></widget></item>
          <item row="2" column="1"><widget class="QLabel" name="lbl_dev_vidpid"><property name="text"><string>—</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="lbl_dev_bustype_cap"><property name="text"><string>Bustype</string></property><property name="styleSheet"><string notr="true">color:#aaa;</string></property></widget></item>
          <item row="3" column="1"><widget class="QLabel" name="lbl_dev_bustype"><property name="text"><string>—  (USB / Bluetooth)</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="4" column="0"><widget class="QLabel" name="lbl_dev_symlinks_cap"><property name="text"><string>Symlinks</string></property><property name="styleSheet"><string notr="true">color:#aaa;</string></property></widget></item>
          <item row="4" column="1"><widget class="QLabel" name="lbl_dev_symlinks"><property name="text"><string>—</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">font-family:monospace; color:#aaa;</string></property></widget></item>
          <item row="5" column="0"><widget class="QLabel" name="lbl_dev_buttons_cap"><property name="text"><string>Buttons</string></property><property name="styleSheet"><string notr="true">color:#aaa;</string></property></widget></item>
          <item row="5" column="1"><widget class="QLabel" name="lbl_dev_buttons"><property name="text"><string>0</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
          <item row="6" column="0"><widget class="QLabel" name="lbl_dev_axes_cap"><property name="text"><string>Axes</string></property><property name="styleSheet"><string notr="true">color:#aaa;</string></property></widget></item>
          <item row="6" column="1"><widget class="QLabel" name="lbl_dev_axes"><property name="text"><string>0</string></property><property name="styleSheet"><string notr="true">font-family:monospace;</string></property></widget></item>
         </layout>
        </widget>
       </item>

       <!-- BLUETOOTH SECTION -->
       <item row="1" column="0" colspan="2">
        <widget class="QGroupBox" name="grp_bluetooth">
         <property name="title"><string>Bluetooth (paired but not connected)</string></property>
         <layout class="QHBoxLayout" name="layout_bluetooth">
          <property name="leftMargin"><number>10</number></property>
          <property name="topMargin"><number>22</number></property>
          <property name="rightMargin"><number>10</number></property>
          <property name="bottomMargin"><number>10</number></property>
          <item>
           <widget class="QListWidget" name="lst_bt_paired">
            <property name="alternatingRowColors"><bool>true</bool></property>
            <property name="toolTip"><string>Paired-but-not-connected Bluetooth gamepads (display only).</string></property>
           </widget>
          </item>
          <item>
           <layout class="QVBoxLayout" name="layout_bt_actions">
            <item>
             <widget class="QPushButton" name="btn_bt_connect">
              <property name="text"><string>Connect</string></property>
              <property name="minimumSize"><size><width>120</width><height>32</height></size></property>
              <property name="toolTip"><string>Display only — actual bluetoothctl wiring done later.</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_bt_disconnect">
              <property name="text"><string>Disconnect</string></property>
              <property name="minimumSize"><size><width>120</width><height>32</height></size></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_bt_rescan">
              <property name="text"><string>Re-scan paired</string></property>
              <property name="minimumSize"><size><width>120</width><height>32</height></size></property>
             </widget>
            </item>
            <item>
             <spacer name="spacer_bt_actions">
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>

   <!-- ============================================================
        BOTTOM STATUS BAR — always visible (topic / device / node / profile)
        ============================================================ -->
   <item>
    <widget class="QFrame" name="frame_bottom_bar">
     <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
     <property name="frameShadow"><enum>QFrame::Sunken</enum></property>
     <layout class="QHBoxLayout" name="layout_bottom_bar">
      <property name="leftMargin"><number>8</number></property>
      <property name="topMargin"><number>4</number></property>
      <property name="rightMargin"><number>8</number></property>
      <property name="bottomMargin"><number>4</number></property>
      <property name="spacing"><number>10</number></property>

      <item>
       <widget class="QLabel" name="lbl_bottom_topic_cap">
        <property name="text"><string>cmd_vel:</string></property>
        <property name="styleSheet"><string notr="true">color:#aaa;</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lbl_bottom_topic">
        <property name="text"><string>/cmd_vel</string></property>
        <property name="styleSheet"><string notr="true">font-family:monospace;</string></property>
       </widget>
      </item>

      <item>
       <widget class="QLabel" name="lbl_bottom_device_cap">
        <property name="text"><string>device:</string></property>
        <property name="styleSheet"><string notr="true">color:#aaa;</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lbl_bottom_device">
        <property name="text"><string>(none)</string></property>
        <property name="styleSheet"><string notr="true">font-family:monospace;</string></property>
       </widget>
      </item>

      <item>
       <widget class="QLabel" name="lbl_bottom_node_cap">
        <property name="text"><string>node:</string></property>
        <property name="styleSheet"><string notr="true">color:#aaa;</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lbl_bottom_node">
        <property name="text"><string>not detected</string></property>
        <property name="styleSheet"><string notr="true">color:#cc6666; font-family:monospace;</string></property>
       </widget>
      </item>

      <item>
       <spacer name="spacer_bottom_mid">
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
       </spacer>
      </item>

      <item>
       <widget class="QLabel" name="lbl_bottom_profile_cap">
        <property name="text"><string>Profile:</string></property>
        <property name="styleSheet"><string notr="true">color:#aaa;</string></property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="cmb_profile">
        <property name="minimumSize"><size><width>180</width><height>0</height></size></property>
        <property name="toolTip"><string>Informational. Applies on Reload YAML.</string></property>
        <item><property name="text"><string>Default</string></property></item>
        <item><property name="text"><string>Slow / Indoor</string></property></item>
        <item><property name="text"><string>Fast / Outdoor</string></property></item>
       </widget>
      </item>

      <item>
       <widget class="QLabel" name="lbl_build_tag">
        <property name="text"><string>teleop_panel · merged v1.0</string></property>
        <property name="styleSheet"><string notr="true">color:#777; font-style:italic;</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>

            <item row="0" column="4"><widget class="QLabel" name="lamp_start_clear"><property name="text"><string>START
CLEAR</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="minimumSize"><size><width>76</width><height>50</height></size></property><property name="styleSheet"><string notr="true">QLabel { background:#222; color:#888; border:1px solid #555; border-radius:4px; font-weight:bold; }</string></property></widget></item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ========================================================
          TAB 2: MAPPING — editable table + button grid + YAML I/O
          ======================================================== -->
     <widget class="QWidget" name="tab_mapping">
      <attribute name="title"><string>Mapping</string></attribute>
      <layout class="QVBoxLayout" name="layout_tab_mapping">
       <property name="spacing"><number>8</number></property>
       <property name="leftMargin"><number>8</number></property>
       <property name="topMargin"><number>10</number></property>
       <property name="rightMargin"><number>8</number></property>
       <property name="bottomMargin"><number>8</number></property>

       <item>
        <widget class="QLabel" name="lbl_mapping_help">
         <property name="text"><string>Logical action ↔ physical input. Cells in Action / Index / Physical Label are editable. Save YAML to persist; Reload YAML to round-trip from disk.</string></property>
         <property name="wordWrap"><bool>true</bool></property>
         <property name="styleSheet"><string notr="true">color:#aaa; font-style:italic;</string></property>
        </widget>
       </item>

       <!-- MAPPING TABLE (editable: Action, Index, Physical Label) -->
       <item>
        <widget class="QTableWidget" name="tbl_mapping">
         <property name="alternatingRowColors"><bool>true</bool></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <property name="columnCount"><number>5</number></property>
         <property name="rowCount"><number>0</number></property>
         <attribute name="horizontalHeaderStretchLastSection"><bool>true</bool></attribute>
         <column><property name="text"><string>Action</string></property></column>
         <column><property name="text"><string>Type</string></property></column>
         <column><property name="text"><string>Index</string></property></column>
         <column><property name="text"><string>Physical Label</string></property></column>
         <column><property name="text"><string>Live State</string></property></column>
        </widget>
       </item>

       <!-- ACTION BUTTON ROW: Add / Remove / Detect / Save / Reload -->
       <item>
        <layout class="QHBoxLayout" name="layout_mapping_actions">
         <property name="spacing"><number>6</number></property>
         <item>
          <widget class="QPushButton" name="btn_add_row">
           <property name="text"><string>+ Add Row</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_remove_row">
           <property name="text"><string>− Remove Row</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_detect_input">
           <property name="text"><string>Detect Input… (press anything)</string></property>
           <property name="toolTip"><string>Highlights whichever button/axis is pressed next.</string></property>
          </widget>
         </item>
         <item>
          <spacer name="spacer_mapping_mid">
           <property name="orientation"><enum>Qt::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
          </spacer>
         </item>
         <item>
          <widget class="QPushButton" name="btn_save_yaml">
           <property name="text"><string>Save YAML</string></property>
           <property name="styleSheet"><string notr="true">QPushButton { background-color: #2e5f3e; color: #d8ffd8; border: 1px solid #3acb3a; font-weight: bold; }
QPushButton:hover { background-color: #357046; }</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_reload_yaml">
           <property name="text"><string>Reload YAML</string></property>
          </widget>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QLabel" name="lbl_yaml_path">
         <property name="text"><string>YAML: (none loaded)</string></property>
         <property name="styleSheet"><string notr="true">color:#888; font-family:monospace;</string></property>
        </widget>
       </item>

